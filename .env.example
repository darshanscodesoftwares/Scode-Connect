# Copy to .env and set the connection for the intended database.
# Leave blank to run the browser-only demo.
DATABASE_URL=
# demo uses fictional seed records. team starts empty in a separate workspace.
SCODECONNECT_WORKSPACE=demo
PORT=5173
# Use 0.0.0.0 to test on a phone connected to the same Wi-Fi.
HOST=0.0.0.0
